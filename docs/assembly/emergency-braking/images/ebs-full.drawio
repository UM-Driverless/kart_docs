          <mxGeometry x="510" y="95" width="130" height="70" as="geometry"/>
        </mxCell>
        <!-- PS2 -->
        <mxCell id="ps2" value="&lt;b&gt;Pressure Sensor&lt;/b&gt;&lt;br&gt;SDE5 (regulated)&lt;br&gt;&lt;font color=&quot;red&quot;&gt;567465&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ea;strokeColor=#188038;" vertex="1" parent="1">
